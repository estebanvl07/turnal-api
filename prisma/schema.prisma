// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ips {
  id          String   @id @default(cuid())
  name        String
  nit         String   @unique
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  users       User[]
  turns       Turn[]
  centers     CareCenter[]
  services    Services[] // Relación con los servicios que ofrece la IPS

  @@index([id, nit])
}

// servicios de la ips
model Services {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  state     Int @default(1) // 1: activo, 2: inactivo


  ipsId     String
  ips       Ips      @relation(fields: [ipsId], references: [id], onDelete: Cascade)

  careCenterServices CareCenterServices[]
  turns Turn[]

  @@index([id, ipsId])
}

// Sedes de atención
model CareCenter {
  id          String @id @default(cuid())
  name        String
  address     String
  ipsId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  
  ips         Ips @relation(fields: [ipsId], references: [id], onDelete: Cascade)

  users               User[]
  placesOfCare        PlacesOfCare[]
  centerServices      CareCenterServices[]
  turns               Turn[]
  status              TurnStatus[]
  placeOfCareServices PlaceOfCareServices[]
  
  @@index([id, ipsId])
}

// servicios de cada sede
  model CareCenterServices {  
    id           String @id @default(cuid())
    careCenterId String
    serviceId    String
    prefix       String
    state        Int @default(1) // 1: activo, 2: inactivo

    careCenter   CareCenter @relation(fields: [careCenterId], references: [id], onDelete: Cascade)
    service      Services   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    placeOfCareServices PlaceOfCareServices[]

    @@unique([careCenterId, prefix])
  }

// servicios de cada lugar de atención
model PlaceOfCareServices {
  id            String @id @default(cuid())
  placeOfCareId String
  serviceId     String

  careCenterId String?

  careCenter   CareCenter? @relation(fields: [careCenterId], references: [id], onDelete: Cascade)
  placeOfCare  PlacesOfCare @relation(fields: [placeOfCareId], references: [id], onDelete: Cascade)
  service      CareCenterServices   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([id, placeOfCareId])
}

// Lugares de atención (consultorio, sala de espera, etc)
model PlacesOfCare {
  id              String   @id @default(cuid())
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  centerId        String
  userId          String?
  
  center          CareCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user            User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  services  PlaceOfCareServices[]
  turns     Turn[]

  @@index([id, centerId])
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String @unique
  role      UserRole @default(USER)
  password  String
  ipsId     String 
  centerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  state     Int @default(1) // 1: activo, 2: inactivo

  ips       Ips @relation(fields: [ipsId], references: [id])
  center    CareCenter? @relation(fields: [centerId], references: [id])
  
  placeOfCare    PlacesOfCare[]  
  tokens    RefreshToken[]
  comments  TurnComments[]
  histories TurnStatusHistory[]

  @@index([id, ipsId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Priority {
  id    Int @id @default(autoincrement())
  name  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  turns Turn[]
}

model Turn {
  id              Int    @id @default(autoincrement())
  code            String
  statusId        Int
  serviceId       String
  careCenterId    String?
  identification  String
  userId          String?
  isPriority      Boolean   @default(false)
  priorityId      Int?
  placesOfCareId  String
  ipsId           String
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ips            Ips          @relation(fields: [ipsId], references: [id], onDelete: Cascade)
  service        Services     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status         TurnStatus   @relation(fields: [statusId], references: [id])
  priority       Priority?    @relation(fields: [priorityId], references: [id])
  placesOfCare   PlacesOfCare @relation(fields: [placesOfCareId], references: [id])
  careCenter     CareCenter?  @relation(fields: [careCenterId], references: [id], onDelete: Cascade)

  comments       TurnComments[]
  history        TurnStatusHistory[]

  @@index([ipsId, serviceId])
  @@index([ipsId, createdAt])
  @@unique([code, ipsId, date]) // opcional: evita códigos duplicados por IPS+fecha
}
model TurnComments {
  id        String @id @default(cuid())
  comment   String
  userId    String
  turnId    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  turn    Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
}

model TurnStatusHistory {
  id             String   @id @default(cuid())
  turnId         Int
  statusId       Int                // estado al que entró
  enteredAt      DateTime @default(now())
  exitedAt       DateTime?          // null hasta que se salga del estado
  durationSeconds Int?              // opcional, se puede calcular pero útil para agregaciones
  performedById  String?            // usuario que realizó la acción (SetNull on delete)
  meta           Json?              // datos extra (notas, motivos, timestamps externos)

  turn           Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  status         TurnStatus @relation(fields: [statusId], references: [id])
  performedBy    User?      @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([turnId, enteredAt])
  @@index([statusId, enteredAt])
}

model TurnStatus {
  id    Int @id @default(autoincrement())
  name  String @unique
  isActive  Boolean @default(true)
  initial   Boolean @default(false)
  final     Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  careCenterId String
  careCenter CareCenter @relation(fields: [careCenterId], references: [id], onDelete: Cascade)

  ipsId String

  history TurnStatusHistory[]
  turns Turn[]
}


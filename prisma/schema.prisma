// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model Ips {
  id          String   @id @default(cuid())
  name        String
  nit         String   @unique
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  users       User[]
  turns       Turn[]
  centers     CareCenter[]
  services    Services[] // Relación con los servicios que ofrece la IPS
}

// servicios de la ips
model Services {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  state     Int @default(1) // 1: activo, 2: inactivo


  ipsId     String
  ips       Ips      @relation(fields: [ipsId], references: [id])

  careCenterServices CareCenterServices[]
  turns Turn[]
}

// Sedes de atención
model CareCenter {
  id          String @id @default(cuid())
  name        String
  address     String
  ipsId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  
  ips         Ips @relation(fields: [ipsId], references: [id])

  users           User[]
  placesOfCare    PlacesOfCare[]
  centerServices  CareCenterServices[]
  turns           Turn[]
}

// servicios de cada sede
  model CareCenterServices {  
    id           String @id @default(cuid())
    careCenterId String
    serviceId    String
    prefix       String
    state        Int @default(1) // 1: activo, 2: inactivo

    careCenter   CareCenter @relation(fields: [careCenterId], references: [id], onDelete: Cascade)
    service      Services   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    placeOfCareServices PlaceOfCareServices[]

    @@unique([careCenterId, prefix])
  }

// servicios de cada lugar de atención
model PlaceOfCareServices {
  id            String @id @default(cuid())
  placeOfCareId String
  serviceId     String

  placeOfCare  PlacesOfCare @relation(fields: [placeOfCareId], references: [id], onDelete: Cascade)
  service      CareCenterServices   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// Lugares de atención (consultorio, sala de espera, etc)
model PlacesOfCare {
  id              String   @id @default(cuid())
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  centerId        String
  userId          String?

  center          CareCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  user            User? @relation(fields: [userId], references: [id])
  
  services  PlaceOfCareServices[]
  turns     Turn[]
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String @unique
  role      UserRole @default(USER)
  password  String
  ipsId     String 
  centerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  state     Int @default(1) // 1: activo, 2: inactivo

  ips       Ips @relation(fields: [ipsId], references: [id])
  center    CareCenter? @relation(fields: [centerId], references: [id])
  
  placeOfCare    PlacesOfCare[]  
  tokens    RefreshToken[]
  comments  TurnComments[]
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Priority {
  id    Int @id @default(autoincrement())
  name  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  turns Turn[]
}

model Turn {
  id              Int    @id @default(autoincrement())
  code            String    
  statusId        Int
  serviceId       String
  careCenterId    String?
  identification  String
  userId          String?
  isPriority      Boolean   @default(false)
  priorityId      Int?
  placesOfCareId  String
  ipsId           String
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  ips           Ips @relation(fields: [ipsId], references: [id])
  service       Services @relation(fields: [serviceId], references: [id])
  status        TurnStatus @relation(fields: [statusId], references: [id])
  priority      Priority? @relation(fields: [priorityId], references: [id])
  placesOfCare  PlacesOfCare @relation(fields: [placesOfCareId], references: [id])
  careCenter    CareCenter? @relation(fields: [careCenterId], references: [id])
  
  comments  TurnComments[]
  @@index([ipsId, serviceId])
}

model TurnComments {
  id        String @id @default(cuid())
  comment   String
  userId    String
  turnId    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  turn    Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
}
  
model TurnStatus {
  id    Int @id @default(autoincrement())
  name  String @unique
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  turns Turn[]
}

